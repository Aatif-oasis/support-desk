# Copy this file to .env and fill in your own values:
#   Windows   : copy backend\.env.example backend\.env
#   Mac/Linux : cp backend/.env.example backend/.env
#
# .env is gitignored on purpose — never commit real secrets.

ENVIRONMENT=development
DEBUG=true

# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
# Avoid @ : / # characters in the password — they break URL parsing.
DATABASE_URL=postgresql+asyncpg://support_desk:CHANGE_ME@localhost:5432/support_desk

REDIS_URL=redis://localhost:6379/0

# Who may create an organization.
# Empty (below) = anyone who can reach the API. Fine locally, wrong on a
# public server — leave it empty here and set a real value in production,
# then pass it as the X-Setup-Key header when onboarding a client.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNUP_SETUP_KEY=

# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Which sites may call this API from a browser. "null" allows the widget
# demo opened directly as a file:// page. In production list your real
# domains only — never use ["*"] together with credentials.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","null"]

# false = webhooks delivered inline (what the test suite expects).
# Set true in production so a slow CRM receiver can't delay a customer's
# message; failed deliveries then retry with backoff.
WEBHOOK_ASYNC_DELIVERY=false
WEBHOOK_MAX_ATTEMPTS=3

# Pre-chat verification question. Off until you turn it on.
CAPTCHA_ENABLED=false

# Only true when nginx or a load balancer sits in front. With no
# proxy, anyone could send X-Forwarded-For and claim any address.
TRUST_FORWARDED_FOR=false
