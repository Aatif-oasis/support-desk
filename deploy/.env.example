# Copy to deploy/.env and fill in. docker compose reads it automatically.
#
#   cp deploy/.env.example deploy/.env
#
# Nothing here has a safe default on purpose: every one of these values
# is either a secret or a hostname only you know.

# ---- Database (runs inside the compose stack) ----
POSTGRES_USER=oasis_chatbot
POSTGRES_DB=oasis_chatbot
# Avoid @ : / # in the password — they break the connection URL.
POSTGRES_PASSWORD=CHANGE_ME

# ---- Secrets ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM

# Required. Without it, anyone who finds your URL can create an
# organization on your server.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNUP_SETUP_KEY=CHANGE_ME_LONG_RANDOM

# ---- Public URLs ----
# Where agents reach the dashboard. This is the only origin allowed to
# call the API from a browser — add each customer site that embeds the
# widget as well.
ALLOWED_ORIGINS=["https://app.yourdomain.example"]

# Where the browser reaches the API. Baked into the dashboard bundle at
# build time, so changing it means rebuilding the dashboard image.
PUBLIC_API_URL=https://api.yourdomain.example

# ---- Sizing ----
# Backend worker processes. Four is comfortable on 2 vCPU / 4 GB.
WEB_CONCURRENCY=4
